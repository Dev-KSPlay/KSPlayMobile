# NuvioEx local configuration template
# Copy this file to local.properties and fill in values locally.
# NEVER commit local.properties or real credentials to Git.
#
# The release workflow expects this file's Base64-encoded contents in the
# repository Actions secret NUVIO_LOCAL_PROPERTIES_BASE64.
# It also currently requires non-empty TRAKT_CLIENT_ID and TRAKT_CLIENT_SECRET
# when preparing a release build.

NUVIO_RELEASE_STORE_PASSWORD=REPLACE_WITH_EXISTING_STORE_PASSWORD
NUVIO_RELEASE_KEY_ALIAS=REPLACE_WITH_EXISTING_KEY_ALIAS
NUVIO_RELEASE_KEY_PASSWORD=REPLACE_WITH_EXISTING_KEY_PASSWORD
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
